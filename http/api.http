@baseUrl = http://localhost:5076
@reportSourceId = 00000000-0000-0000-0000-000000000000

# Set this before running the register, create-user or login requests below.
#
# Deliberately empty rather than a working default. This repository is public, so a
# real value here becomes the admin password on every instance bootstrapped by
# copying these requests — which is exactly what happened once. Empty makes the API
# answer 400 "email and password are required" until you choose one, instead of
# quietly creating an account whose password anyone can look up.
@password =

### Check whether first-run bootstrap is needed
GET {{baseUrl}}/api/v1/auth/setup

### Bootstrap the first administrator (only works when no users exist)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "admin@agency.tld",
  "password": "{{password}}",
  "displayName": "Agency Admin"
}

### List users (admin only)
GET {{baseUrl}}/api/v1/users

### Create user (admin only; roles: agency_admin | agency_analyst | client_viewer)
POST {{baseUrl}}/api/v1/users
Content-Type: application/json

{
  "email": "viewer@client.tld",
  "password": "{{password}}",
  "displayName": "Client Viewer",
  "role": "client_viewer"
}

### Create an SSO-only user (admin only; no password, signs in through OIDC)
POST {{baseUrl}}/api/v1/users
Content-Type: application/json

{
  "email": "sso.staff@agency.tld",
  "displayName": "SSO Staff",
  "role": "agency_analyst"
}

### Update user (admin only)
PATCH {{baseUrl}}/api/v1/users/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "role": "agency_analyst",
  "isActive": true
}

### Replace a client_viewer's client grants (admin only, set semantics)
PUT {{baseUrl}}/api/v1/users/00000000-0000-0000-0000-000000000000/grants
Content-Type: application/json

{
  "clientIds": ["00000000-0000-0000-0000-000000000000"]
}

### Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@agency.tld",
  "password": "{{password}}"
}

### Get current user
GET {{baseUrl}}/api/v1/auth/me

### Logout
POST {{baseUrl}}/api/v1/auth/logout

### Health/status
GET {{baseUrl}}/api/v1/system/status

### Apply migrations
POST {{baseUrl}}/api/v1/admin/database/migrate

### List clients
GET {{baseUrl}}/api/v1/clients

### Create client
POST {{baseUrl}}/api/v1/clients
Content-Type: application/json

{
  "name": "Acme Demo",
  "slug": "acme-demo",
  "retentionMonths": 27,
  "timezone": "UTC",
  "isActive": true
}

### Get client by id (replace id)
GET {{baseUrl}}/api/v1/clients/00000000-0000-0000-0000-000000000000

### Patch client (replace id)
PATCH {{baseUrl}}/api/v1/clients/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "timezone": "Europe/Copenhagen"
}

### List domains
GET {{baseUrl}}/api/v1/domains

### List domains by clientId (replace clientId)
GET {{baseUrl}}/api/v1/domains?clientId=00000000-0000-0000-0000-000000000000

### Create domain (replace clientId)
POST {{baseUrl}}/api/v1/domains
Content-Type: application/json

{
  "clientId": "00000000-0000-0000-0000-000000000000",
  "name": "example.com",
  "isActive": true
}

### Get domain by id (replace id)
GET {{baseUrl}}/api/v1/domains/00000000-0000-0000-0000-000000000000

### Patch domain (replace id)
PATCH {{baseUrl}}/api/v1/domains/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "isActive": false
}

### List report sources
GET {{baseUrl}}/api/v1/report-sources

### Create report source (replace defaultClientId)
POST {{baseUrl}}/api/v1/report-sources
Content-Type: application/json

{
  "name": "Acme DMARC Inbox",
  "protocol": "imap",
  "host": "imap.example.com",
  "port": 993,
  "useTls": true,
  "username": "dmarc@example.com",
  "password": "replace-me",
  "defaultClientId": "00000000-0000-0000-0000-000000000000",
  "isActive": true
}

### Patch report source (replace id)
PATCH {{baseUrl}}/api/v1/report-sources/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "isActive": false,
  "port": 995,
  "protocol": "pop3"
}

### Manual mailbox sync (IMAP only; read-only, does not delete emails)
POST {{baseUrl}}/api/v1/report-sources/{{reportSourceId}}/sync

### List mailbox sync runs (optional reportSourceId, optional limit)
GET {{baseUrl}}/api/v1/mailbox-sync-runs?reportSourceId={{reportSourceId}}&limit=20

### Mailbox health summary (optional reportSourceId)
GET {{baseUrl}}/api/v1/mailbox-health?reportSourceId={{reportSourceId}}
