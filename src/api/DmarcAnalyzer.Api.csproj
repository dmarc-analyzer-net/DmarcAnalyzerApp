<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emit the XML doc file so the compiler *checks* doc comments: without it,
         a summary written on a record positional parameter is silently discarded
         (CS1587) and a cref pointing at a renamed member never breaks (CS1574).
         CS1591/CS1573 (member or parameter without a comment) stay off on
         purpose — the house style documents what is surprising, not every
         ClientName property. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.4" />
    <PackageReference Include="Carter" Version="10.0.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="DmarcRua" Version="2.1.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pulled in transitively, but referenced explicitly so the 10.0.11 pin reaches
         the test project too: EntityFrameworkCore.Design carries the same pin and is
         PrivateAssets=all, so without this the tests build against the Npgsql
         provider's 10.0.0 floor while the API builds against 10.0.11. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <!-- Not used directly: MimeKit depends on it at the first .NET 10 release, which
         carries GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Referenced here to lift
         it to the patched servicing release until MimeKit raises its own floor. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
